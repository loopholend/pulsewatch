# PulseWatch Environment Configuration
# ======================================
# Copy this file to .env and fill in your values.
# NEVER commit your .env file to source control.
#
# Quick start:
#   cp .env.example .env
#   # Edit .env and set required values
#   docker-compose up --build

# ============================================================
# REQUIRED — Application will NOT start without these
# ============================================================

# JWT signing secret. Must be a strong random hex string (min 32 bytes).
# Generate with: openssl rand -hex 32
JWT_SECRET=

# ============================================================
# DATABASE
# ============================================================
# Host: set to "postgres" when using docker-compose, "localhost" for local dev
DB_HOST=postgres
DB_PORT=5432
DB_NAME=pulsewatch
DB_USERNAME=postgres
DB_PASSWORD=changeme

# ============================================================
# CORS
# ============================================================
# Comma-separated list of allowed origins for CORS.
# For local dev: http://localhost:80 or http://localhost:5173
# For production: https://your-domain.com
CORS_ALLOWED_ORIGINS=http://localhost

# ============================================================
# APPLICATION
# ============================================================
# Base URL of the BACKEND (used for verification email links).
# In Docker: http://localhost:8080 or your public URL.
APP_BASE_URL=http://localhost:8080

# ============================================================
# OPTIONAL — Email Alerts
# ============================================================
# Configure these to enable email alert delivery.
# Without these, alerts will log as FAILED but the app still runs.
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# ============================================================
# OPTIONAL — GitHub OAuth (for GitHub login)
# ============================================================
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost/oauth2/callback/github

# ============================================================
# AZURE DEPLOYMENT (fill when deploying to Azure Container Apps)
# ============================================================
# AZURE_ACR_NAME=        # your Azure Container Registry name
# AZURE_RESOURCE_GROUP=  # your resource group name
# AZURE_LOCATION=eastus  # Azure region
