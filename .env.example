# PulseWatch Environment Configuration
# ======================================
# Copy this file to .env and fill in your values.
# NEVER commit your .env file to source control.
#
# Quick start:
#   cp .env.example .env
#   # Edit .env and set JWT_SECRET
#   docker-compose up --build

# ============================================================
# REQUIRED — Application will not start without this
# ============================================================

# JWT signing secret. Must be a strong random hex string (min 32 bytes).
# Generate one with: openssl rand -hex 32
JWT_SECRET=

# ============================================================
# DATABASE
# ============================================================
# Password used by both Postgres container and backend datasource
DB_PASSWORD=changeme

# ============================================================
# OPTIONAL — Email Alerts
# ============================================================
# Configure these to enable email alert delivery.
# Without these, alerts will log as FAILED but the app still runs.
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
