# PulseWatch v1.0.0 — Environment Configuration
# ================================================
# Copy this file to .env and configure your values.
# NEVER commit your .env file (it is excluded by .gitignore).
#
# Quick start (Linux/macOS):
#   cp .env.example .env
#   JWT_SECRET=$(openssl rand -hex 32)
#   sed -i "s/JWT_SECRET=/JWT_SECRET=$JWT_SECRET/" .env
#   docker compose up --build
#
# Quick start (Windows PowerShell):
#   Copy-Item .env.example .env
#   $s = -join ((48..57 + 65..90 + 97..122) | Get-Random -Count 64 | % {[char]$_})
#   (Get-Content .env) -replace 'JWT_SECRET=', "JWT_SECRET=$s" | Set-Content .env
#   docker compose up --build

# ============================================================
# REQUIRED — Application will NOT start without this
# ============================================================

# JWT signing secret. Must be 256-bit random hex (64 hex chars = 32 bytes).
# Linux/macOS: openssl rand -hex 32
# Windows:     -join ((48..57 + 65..90 + 97..122) | Get-Random -Count 64 | % {[char]$_})
JWT_SECRET=

# ============================================================
# DATABASE (auto-configured for docker-compose)
# ============================================================
# DB_HOST: use "postgres" for docker-compose, "localhost" for local dev
# For Azure PostgreSQL: yoursever.postgres.database.azure.com
DB_HOST=postgres
DB_PORT=5432
DB_NAME=pulsewatch
DB_USERNAME=postgres
DB_PASSWORD=changeme

# ============================================================
# CORS & URL CONFIGURATION
# ============================================================
# Comma-separated allowed CORS origins. For production, specify exact domain.
# Local dev: http://localhost  |  Production: https://yourdomain.com
CORS_ALLOWED_ORIGINS=http://localhost

# Backend public URL (used in actuator, health probes)
APP_BASE_URL=http://localhost:8080

# Frontend public URL (used in email action links — must be publicly accessible)
FRONTEND_URL=http://localhost

# ============================================================
# SPRING PROFILE
# ============================================================
# "default" for local docker-compose (no SSL, swagger enabled)
# "prod" for Azure Container Apps (SSL required, swagger disabled, scoped CORS)
SPRING_PROFILES_ACTIVE=default

# ============================================================
# EMAIL ALERTS (OPTIONAL)
# ============================================================
# Leave MAIL_USERNAME and MAIL_PASSWORD empty to disable email delivery.
# When empty, alert rules still work but emails log as FAILED (app continues).
#
# For Mailtrap (testing):
#   MAIL_HOST=smtp.mailtrap.io  MAIL_PORT=587
#   MAIL_USERNAME=your-mailtrap-user  MAIL_PASSWORD=your-mailtrap-pass
#   MAIL_SMTP_AUTH=true  MAIL_SMTP_STARTTLS=true
#
# For Gmail:
#   MAIL_HOST=smtp.gmail.com  MAIL_PORT=587
#   MAIL_USERNAME=yourmail@gmail.com  MAIL_PASSWORD=your-app-password
#   MAIL_SMTP_AUTH=true  MAIL_SMTP_STARTTLS=true
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS=false

# ============================================================
# APPLICATION BEHAVIOR
# ============================================================
# Number of consecutive failures before an incident is opened (default: 3)
FAILURE_THRESHOLD=3

# Scheduler thread pool size (default: 20 — supports up to ~20 monitors in parallel)
SCHEDULER_THREAD_POOL=20

# ============================================================
# DATA RETENTION
# ============================================================
# Enable automatic deletion of old check results (default: true)
PRUNING_ENABLED=true
# Number of days to keep check results (default: 30)
PRUNING_DAYS=30

# ============================================================
# AZURE CONTAINER APPS DEPLOYMENT
# ============================================================
# Fill these when deploying to Azure. See README for full guide.
#
# ACR_NAME=pulsewatchacr           # Azure Container Registry name
# RESOURCE_GROUP=pulsewatch-rg     # Azure Resource Group
# AZURE_LOCATION=eastus            # Azure region
# DB_SERVER_NAME=pulsewatch-db     # Azure PostgreSQL server name
