# Root .gitignore for PulseWatch

# --- SECRETS - NEVER COMMIT ---
.env
.env.*
!.env.example

# --- BUILD OUTPUTS ---
target/
dist/
build/
node_modules/

# --- LOCAL AGENT / SCRATCH ---
.agents/
scratch/

# --- IDE CONFIGURATIONS ---
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# --- OS METADATA ---
.DS_Store
Thumbs.db

# --- LOGS ---
*.log
logs/
CREDENTIALS.md
.env
